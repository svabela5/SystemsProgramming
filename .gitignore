# Ignore object files
*.o
*.obj

# Ignore compiled static libraries
*.a
*.lib

# Ignore compiled dynamic libraries
*.so
*.dll
*.dylib

# Ignore executables
*.exe
*.out
*.elf

# Ignore debug and profiling files
*.pdb
*.idb
*.ilk
*.exp
*.map
*.dbg
*.gch

# Ignore build directories
/build/
/bin/
/dist/
/Debug/
/Release/

# Ignore temporary files
*.tmp
*.log
*.bak
*.swp

# Ignore compiler cache
.ccache/

# Ignore IDE-specific build folders (optional)
.vscode/
.idea/
